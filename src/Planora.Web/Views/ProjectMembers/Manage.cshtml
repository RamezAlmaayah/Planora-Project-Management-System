@model Planora.Web.ViewModels.ProjectMembers.ManageProjectMembersViewModel
@using Planora.Domain.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Team Members";
    Layout = "_AppLayout";

    string methodology =
        Model.Methodology.ToString() == "VModel"
            ? "V-Model"
            : Model.Methodology.ToString();

    string statusClass =
        Model.Status
            .ToString()
            .ToLowerInvariant();
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/projects.css"
          asp-append-version="true" />
}

<div class="members-v3-page">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="app-alert app-alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="app-alert app-alert-error">
            @errorMessage
        </div>
    }


    <!-- =====================================================
         BACK
         ===================================================== -->

    <div class="members-v3-back">

        <a asp-controller="Projects"
           asp-action="Details"
           asp-route-id="@Model.ProjectId">
            ← Back to project
        </a>

    </div>


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <section class="members-v3-header">

        <div>

            <div class="members-v3-tags">

                <span class="projects-v3-method">
                    @methodology
                </span>

                <span class="projects-v3-status status-@statusClass">
                    @Model.Status
                </span>

            </div>


            <h1>
                Team members
            </h1>


            <p>
                Manage project members and project-level roles for
                <strong>@Model.ProjectName</strong>.
            </p>

        </div>


        <div class="members-v3-count">

            <span>
                Total members
            </span>

            <strong>
                @Model.Members.Count
            </strong>

        </div>

    </section>


    <!-- =====================================================
         ARCHIVED WARNING
         ===================================================== -->

    @if (Model.IsArchived)
    {
        <div class="app-alert app-alert-warning">

            This project is archived.
            Membership changes are disabled.

        </div>
    }


    <!-- =====================================================
         ADD MEMBER
         ===================================================== -->

    @if (!Model.IsArchived)
    {
        <section class="members-v3-add-panel">

            <div class="members-v3-panel-head">

                <div>

                    <span>
                        TEAM MANAGEMENT
                    </span>

                    <h2>
                        Add team member
                    </h2>

                    <p>
                        Select an available user and assign a valid project role.
                    </p>

                </div>

            </div>


            @if (Model.AvailableUsers.Count == 0)
            {
                <div class="members-v3-empty">

                    <div class="members-v3-empty-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                            <circle cx="9"
                                    cy="7"
                                    r="4" />

                            <path d="M19 8v6" />

                            <path d="M22 11h-6" />

                        </svg>

                    </div>

                    <strong>
                        No available users
                    </strong>

                    <p>
                        All eligible users are already assigned,
                        or there are no confirmed users available.
                    </p>

                </div>
            }
            else
            {
                <div class="members-v3-available-grid">

                    @foreach (var user in Model.AvailableUsers)
                    {
                        string initial =
                            string.IsNullOrWhiteSpace(user.FullName)
                                ? "U"
                                : user.FullName[..1].ToUpperInvariant();

                        <article class="members-v3-user-card">

                            <div class="members-v3-user">

                                <div class="members-v3-avatar">
                                    @initial
                                </div>


                                <div class="members-v3-user-copy">

                                    <strong>
                                        @user.FullName
                                    </strong>

                                    <span>
                                        @user.Email
                                    </span>

                                </div>

                            </div>


                            <form asp-controller="ProjectMembers"
                                  asp-action="Add"
                                  method="post"
                                  class="members-v3-add-form">

                                <input type="hidden"
                                       name="projectId"
                                       value="@Model.ProjectId" />

                                <input type="hidden"
                                       name="userId"
                                       value="@user.UserId" />


                                <select name="role"
                                        aria-label="Project role">

                                    @foreach (var role in user.EligibleRoles)
                                    {
                                        <option value="@((int)role)">
                                            @FormatRole(role)
                                        </option>
                                    }

                                </select>


                                <button type="submit">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round">

                                        <path d="M12 5v14" />
                                        <path d="M5 12h14" />

                                    </svg>

                                    Add member

                                </button>

                            </form>

                        </article>
                    }

                </div>
            }

        </section>
    }


    <!-- =====================================================
         CURRENT MEMBERS
         ===================================================== -->

    <section class="members-v3-table-panel">

        <div class="members-v3-panel-head">

            <div>

                <span>
                    PROJECT TEAM
                </span>

                <h2>
                    Current members
                </h2>

                <p>
                    @Model.Members.Count @(Model.Members.Count == 1 ? "member" : "members")
                    assigned to this project.
                </p>

            </div>

        </div>


        @if (Model.Members.Count == 0)
        {
            <div class="members-v3-empty">

                <div class="members-v3-empty-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                        <circle cx="9"
                                cy="7"
                                r="4" />

                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />

                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />

                    </svg>

                </div>

                <strong>
                    No members yet
                </strong>

                <p>
                    Add an eligible user above to start building the project team.
                </p>

            </div>
        }
        else
        {
            <div class="members-v3-table">

                <div class="members-v3-table-head">

                    <span>
                        Member
                    </span>

                    <span>
                        Project role
                    </span>

                    <span>
                        Joined
                    </span>

                    <span>
                        Actions
                    </span>

                </div>


                @foreach (var member in Model.Members)
                {
                    string memberInitial =
                        string.IsNullOrWhiteSpace(member.FullName)
                            ? "U"
                            : member.FullName[..1].ToUpperInvariant();

                    string joinedDate =
                        member.JoinedAt.ToString(
                            "dd MMM yyyy",
                            CultureInfo.InvariantCulture);


                    <div class="members-v3-row">

                        <!-- MEMBER -->

                        <div class="members-v3-user">

                            <div class="members-v3-avatar">
                                @memberInitial
                            </div>


                            <div class="members-v3-user-copy">

                                <strong>
                                    @member.FullName
                                </strong>

                                    <span>
                                        @member.Email
                                    </span>

                                    <span class="members-v3-account-meta">
                                        @member.GlobalRole &middot; @(member.IsDisabled ? "Disabled" : "Enabled")
                                    </span>

                            </div>

                        </div>


                        <!-- ROLE -->

                        @if (!Model.IsArchived)
                        {
                            <form asp-controller="ProjectMembers"
                                  asp-action="UpdateRole"
                                  method="post"
                                  class="members-v3-role-form">

                                <input type="hidden"
                                       name="projectId"
                                       value="@Model.ProjectId" />

                                <input type="hidden"
                                       name="membershipId"
                                       value="@member.MembershipId" />


                                <select name="role"
                                        aria-label="Member project role">

                                    @foreach (
                                        ProjectMemberRole role
                                        in Enum.GetValues<ProjectMemberRole>())
                                    {
                                        if (member.Role == role)
                                        {
                                            <option value="@((int)role)"
                                                    selected>
                                                @FormatRole(role)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@((int)role)">
                                                @FormatRole(role)
                                            </option>
                                        }
                                    }

                                </select>


                                <button type="submit">
                                    Update
                                </button>

                            </form>
                        }
                        else
                        {
                            <span class="members-v3-role-pill">
                                @FormatRole(member.Role)
                            </span>
                        }


                        <!-- JOINED -->

                        <div class="members-v3-joined">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <rect x="3"
                                      y="5"
                                      width="18"
                                      height="16"
                                      rx="2" />

                                <path d="M16 3v4" />

                                <path d="M8 3v4" />

                                <path d="M3 11h18" />

                            </svg>

                            <span>
                                @joinedDate
                            </span>

                        </div>


                        <!-- ACTION -->

                        <div class="members-v3-actions">

                            @if (!Model.IsArchived)
                            {
                                <form asp-controller="ProjectMembers"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="projectId"
                                           value="@Model.ProjectId" />

                                    <input type="hidden"
                                           name="membershipId"
                                           value="@member.MembershipId" />


                                    <button type="submit"
                                            class="members-v3-remove">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M3 6h18" />

                                            <path d="M8 6V4h8v2" />

                                            <path d="M19 6l-1 14H6L5 6" />

                                            <path d="M10 11v5" />

                                            <path d="M14 11v5" />

                                        </svg>

                                        Remove

                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="members-v3-locked">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <rect x="5"
                                              y="11"
                                              width="14"
                                              height="10"
                                              rx="2" />

                                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />

                                    </svg>

                                    Locked

                                </span>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>


@functions
{
    private static string FormatRole(
        ProjectMemberRole role)
    {
        return role switch
        {
            ProjectMemberRole.ProjectManager =>
                "Project Manager",

            ProjectMemberRole.ScrumMaster =>
                "Scrum Master",

            ProjectMemberRole.Developer =>
                "Developer",

            ProjectMemberRole.QaTester =>
                "QA Tester",

            _ =>
                role.ToString()
        };
    }
}
