@{
    ViewData["Title"] = "Contact Us";
    Layout = "_PublicLayout";
}

<style>

    .contact-page {
        min-height: calc(100vh - 88px);

        padding: 70px 7% 90px;

        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            minmax(420px, .9fr);

        align-items: center;
        gap: 90px;

        background: #f7f7f5;
    }


    /* ========================================
       LEFT CONTENT
       ======================================== */

    .contact-kicker {
        display: block;

        margin-bottom: 18px;

        color: #777771;

        font-size: 12px;
        font-weight: 700;

        letter-spacing: .14em;
    }

    .contact-copy h1 {
        max-width: 720px;

        margin: 0;

        color: #171717;

        font-size: clamp(48px, 5vw, 72px);
        font-weight: 600;

        line-height: 1.02;

        letter-spacing: -.05em;
    }

    .contact-copy > p {
        max-width: 640px;

        margin: 24px 0 0;

        color: #666660;

        font-size: 16px;
        line-height: 1.75;
    }


    /* ========================================
       CONTACT DETAILS
       ======================================== */

    .contact-details {
        margin-top: 42px;

        display: grid;
        gap: 12px;
    }

    .contact-item {
        min-height: 72px;

        padding: 14px 16px;

        display: flex;
        align-items: center;
        gap: 15px;

        border: 1px solid #e2e1dc;
        border-radius: 12px;

        background: #ffffff;

        text-decoration: none;

        transition:
            background-color 140ms ease,
            border-color 140ms ease;
    }

    a.contact-item:hover {
        background: #f2f2ef;
        border-color: #d8d7d2;
    }

    .contact-icon {
        width: 42px;
        height: 42px;

        min-width: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: #f1f1ee;
        color: #171717;
    }

    .contact-icon svg {
        width: 19px;
        height: 19px;
    }

    .contact-item-content {
        min-width: 0;

        display: grid;
        gap: 3px;
    }

    .contact-item-content span {
        color: #8a8a84;

        font-size: 11px;
        font-weight: 600;

        letter-spacing: .06em;

        text-transform: uppercase;
    }

    .contact-item-content strong {
        color: #171717;

        font-size: 15px;
        font-weight: 600;

        word-break: break-word;
    }


    /* ========================================
       SOCIAL ICONS
       ======================================== */

    .contact-social-block {
        margin-top: 30px;
    }

    .contact-social-label {
        display: block;

        margin-bottom: 12px;

        color: #8a8a84;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: .1em;

        text-transform: uppercase;
    }

    .contact-socials {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .contact-social {
        width: 44px;
        height: 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #deded9;
        border-radius: 10px;

        background: #ffffff;
        color: #171717;

        cursor: default;
    }

    .contact-social svg {
        width: 19px;
        height: 19px;
    }


    /* ========================================
       PERSON IMAGE
       ======================================== */

    .contact-visual {
        min-height: 610px;

        position: relative;

        display: flex;
        align-items: flex-end;
        justify-content: center;

        overflow: hidden;

        border: 1px solid #e1e0db;
        border-radius: 22px;

        background:
            radial-gradient(
                circle at 50% 40%,
                #ffffff 0%,
                #f1f1ed 58%,
                #e9e9e4 100%
            );
    }

    .contact-visual::before {
        content: "";

        width: 360px;
        height: 360px;

        position: absolute;

        left: 50%;
        top: 50%;

        transform: translate(-50%, -50%);

        border-radius: 50%;

        background: rgba(255,255,255,.72);
    }

    .contact-person {
        width: min(520px, 100%);
        max-height: 590px;

        position: relative;
        z-index: 1;

        display: block;

        object-fit: contain;
        object-position: center bottom;
    }

    .contact-visual-note {
        position: absolute;

        right: 24px;
        bottom: 24px;

        z-index: 2;

        padding: 10px 13px;

        border: 1px solid rgba(0,0,0,.08);
        border-radius: 10px;

        background: rgba(255,255,255,.88);

        color: #666660;

        font-size: 12px;

        backdrop-filter: blur(10px);
    }


    /* ========================================
       RESPONSIVE
       ======================================== */

    @@media (max-width: 1000px) {

        .contact-page {
            grid-template-columns: 1fr;
        }

        .contact-visual {
            min-height: 520px;
        }
    }

    @@media (max-width: 650px) {

        .contact-page {
            padding:
                50px
                24px
                70px;
        }

        .contact-copy h1 {
            font-size: 44px;
        }

        .contact-visual {
            min-height: 420px;
        }
    }


    /* ===== CONTACT IMAGE FINAL ===== */

    .contact-visual {
        min-height: 610px !important;
        padding: 0 !important;
        overflow: hidden !important;

        display: block !important;

        border: 1px solid #e1e0db !important;
        border-radius: 22px !important;

        background: #ffffff !important;
    }

    .contact-visual::before {
        display: none !important;
        content: none !important;
    }

    .contact-person {
        width: 100% !important;
        height: 100% !important;
        min-height: 610px !important;
        max-height: none !important;

        display: block !important;

        object-fit: cover !important;
        object-position: center !important;

        margin: 0 !important;
        padding: 0 !important;

        border-radius: 21px !important;
    }

    /* ===== END CONTACT IMAGE FINAL ===== */
</style>


