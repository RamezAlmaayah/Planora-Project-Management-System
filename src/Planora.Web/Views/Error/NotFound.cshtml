@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>404 - Page Not Found | Planora</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            background: #ffffff;
            color: #171717;
            font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }


        /* ================================
           TOPBAR
           ================================ */

        .nf-topbar {
            width: 100%;
            min-height: 82px;
            padding: 0 6%;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            border-bottom: 1px solid #eeeeeb;
            background: #ffffff;
        }

        .nf-logo {
            color: #171717;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.04em;
            text-decoration: none;
        }

        .nf-nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

            .nf-nav a,
            .nf-login {
                color: #74746f;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                transition: color 140ms ease;
            }

                .nf-nav a:hover,
                .nf-login:hover {
                    color: #171717;
                }

        .nf-account {
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .nf-dashboard {
            min-height: 40px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #171717;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }


        /* ================================
           MAIN
           ================================ */

        .nf-main {
            min-height: calc(100vh - 82px);
            padding: 35px 24px 70px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nf-content {
            width: 100%;
            max-width: 720px;
            text-align: center;
        }


        /* ================================
           PLUG IMAGE
           ================================ */

        .nf-plug-image {
            width: min(620px, 88vw);
            height: auto;
            display: block;
            margin: 0 auto -5px;
            object-fit: contain;
        }


        /* ================================
           404
           ================================ */

        .nf-code {
            margin-top: -5px;
            color: #151515;
            font-size: clamp(110px, 13vw, 165px);
            font-weight: 800;
            line-height: .9;
            letter-spacing: -0.065em;
        }

        .nf-title {
            margin-top: 24px;
            color: #171717;
            font-size: clamp(25px, 3vw, 34px);
            font-weight: 700;
            letter-spacing: -0.035em;
        }

        .nf-description {
            width: min(520px, 90%);
            margin: 14px auto 0;
            color: #888883;
            font-size: 13px;
            line-height: 1.75;
        }


        /* ================================
           BUTTONS
           ================================ */

        .nf-actions {
            margin-top: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .nf-button {
            min-height: 42px;
            padding: 0 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1.5px solid #171717;
            border-radius: 999px;
            background: #171717;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            text-decoration: none;
            transition: background-color 140ms ease, color 140ms ease;
        }

            .nf-button:hover {
                background: #ffffff;
                color: #171717;
            }

        .nf-button-secondary {
            background: #ffffff;
            color: #171717;
        }

            .nf-button-secondary:hover {
                background: #f3f3f0;
            }


        /* ================================
           MOBILE
           ================================ */

        @@media (max-width: 700px) {

            .nf-topbar {
                min-height: 70px;
                padding: 0 22px;
                grid-template-columns: 1fr auto;
            }

            .nf-nav {
                display: none;
            }

            .nf-account {
                grid-column: 2;
            }

            .nf-main {
                min-height: calc(100vh - 70px);
                padding-top: 20px;
            }

            .nf-plug-image {
                width: 92vw;
            }

            .nf-code {
                font-size: 105px;
            }

            .nf-title {
                font-size: 24px;
            }

            .nf-actions {
                flex-direction: column;
            }

            .nf-button {
                min-width: 180px;
            }
        }
    
        /* ===== 404 TYPOGRAPHY OVERRIDE ===== */

        .nf-code {
            font-size: 118px !important;
            font-weight: 650 !important;
            line-height: 0.92 !important;
            letter-spacing: -3px !important;
            color: #151515 !important;
        }

        .nf-title {
            margin-top: 22px !important;
            margin-bottom: 12px !important;

            font-size: 27px !important;
            font-weight: 700 !important;
            line-height: 1.25 !important;

            letter-spacing: -0.035em !important;
            color: #171717 !important;
        }

        .nf-description {
            width: min(570px, 92%) !important;

            margin: 0 auto !important;

            font-size: 15px !important;
            font-weight: 400 !important;
            line-height: 1.75 !important;

            color: #6f6f6a !important;
        }

        /* ===== END 404 TYPOGRAPHY OVERRIDE ===== */
    
        /* ===== 404 TOPBAR FINAL ===== */

        .nf-topbar {
            min-height: 90px !important;
            padding: 0 6.5% !important;

            display: grid !important;
            grid-template-columns: 1fr auto 1fr !important;

            align-items: center !important;

            border-bottom: 1px solid #e9e9e6 !important;
            background: #ffffff !important;
        }

        .nf-logo {
            font-size: 24px !important;
            font-weight: 700 !important;
            letter-spacing: -0.045em !important;
            color: #171717 !important;
        }

        .nf-nav {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 30px !important;
        }

        .nf-nav a {
            min-height: 40px !important;

            padding: 0 10px !important;

            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;

            border-radius: 8px !important;

            color: #60605b !important;

            font-size: 15px !important;
            font-weight: 500 !important;

            text-decoration: none !important;

            transition:
                background-color 140ms ease,
                color 140ms ease !important;
        }

        .nf-nav a:hover {
            background: #f4f4f1 !important;
            color: #171717 !important;
        }

        .nf-account {
            display: flex !important;
            align-items: center !important;
            justify-content: flex-end !important;
        }

        .nf-login {
            min-height: 43px !important;

            padding: 0 18px !important;

            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;

            border: 1px solid #ddddda !important;
            border-radius: 9px !important;

            background: #ffffff !important;
            color: #171717 !important;

            font-size: 14px !important;
            font-weight: 600 !important;

            text-decoration: none !important;
        }

        .nf-login:hover {
            background: #f4f4f1 !important;
        }

        .nf-dashboard {
            min-height: 43px !important;

            padding: 0 18px !important;

            border-radius: 9px !important;

            font-size: 14px !important;
            font-weight: 600 !important;
        }

        /* ===== END 404 TOPBAR FINAL ===== */
    
        /* ===== PLANORA BRAND LOGO ===== */

        .nf-logo {
            display: inline-flex !important;
            align-items: center !important;
            gap: 10px !important;
        }

        .nf-brand-logo {
            width: 38px !important;
            height: 38px !important;
            object-fit: contain !important;
            display: block !important;
        }

        .nf-logo span {
            font-size: 24px !important;
            font-weight: 700 !important;
            letter-spacing: -0.045em !important;
        }

        /* ===== END PLANORA BRAND LOGO ===== */

        /* ===== 404 LOGO FINAL SIZE ===== */

        .nf-brand-logo {
            width: 46px !important;
            height: 46px !important;
            min-width: 46px !important;
            object-fit: contain !important;
        }

        .nf-logo {
            gap: 11px !important;
        }

        /* ===== END 404 LOGO FINAL SIZE ===== */

        /* Keep the compact header authoritative after the desktop scale rules. */
        @@media (max-width: 700px) {
            .nf-topbar {
                min-height: 70px !important;
                padding: 0 22px !important;
                grid-template-columns: 1fr auto !important;
            }

            .nf-nav {
                display: none !important;
            }

            .nf-account {
                grid-column: 2;
            }

            .nf-brand-logo {
                width: 40px !important;
                height: 40px !important;
                min-width: 40px !important;
            }

            .nf-logo span {
                font-size: 21px !important;
            }
        }
</style>
</head>

<body>

    <header class="nf-topbar">

        <a asp-controller="Home"
           asp-action="Index"
           class="nf-logo">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="nf-brand-logo" />
    <span>Planora</span>
</a>


        <nav class="nf-nav">

            <a asp-controller="Home"
               asp-action="Index">
                Home
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="features">
                Features
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="about">
                About
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="contact">
                Contact
            </a>

        </nav>


        <div class="nf-account">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nf-dashboard">
                    Dashboard
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="nf-login">
                    Log in
                </a>
            }

        </div>

    </header>


    <main class="nf-main">

        <div class="nf-content">

            <img src="~/images/errors/404-disconnected-plug.png"
                 asp-append-version="true"
                 alt="Disconnected electrical plug"
                 class="nf-plug-image" />


            <div class="nf-code">
                404
            </div>


            <h1 class="nf-title">
                Oops, Page Not Found
            </h1>


            <p class="nf-description">

                The page you are looking for might have been removed,
                had its name changed, or is temporarily unavailable.

            </p>


            <div class="nf-actions">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nf-button">
                    Go Back Home
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nf-button nf-button-secondary">
                        Dashboard
                    </a>
                }

            </div>

        </div>

    </main>

</body>

</html>



