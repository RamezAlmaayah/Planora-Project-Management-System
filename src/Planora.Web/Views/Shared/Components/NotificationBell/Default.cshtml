@model Planora.Web.ViewModels.Notifications.NotificationBellViewModel
@using System.Globalization

<details class="notification-bell">
    <summary aria-label="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M10 21h4" />
        </svg>
        @if (Model.UnreadCount > 0)
        {
            <span class="notification-badge">@(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount)</span>
        }
    </summary>
    <div class="notification-popover">
        <div class="notification-popover-head">
            <strong>Notifications</strong>
            <span>@Model.UnreadCount unread</span>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <p class="notification-empty">No notifications yet.</p>
        }
        else
        {
            <div class="notification-popover-list">
                @foreach (var notification in Model.Recent)
                {
                    <div class="notification-popover-item @(notification.IsRead ? "" : "is-unread")">
                        @if (!string.IsNullOrWhiteSpace(notification.TargetUrl))
                        {
                            <a href="@notification.TargetUrl">
                                <strong>@notification.Title</strong>
                                <span>@notification.Message</span>
                            </a>
                        }
                        else
                        {
                            <strong>@notification.Title</strong>
                            <span>@notification.Message</span>
                        }
                        <small>@notification.CreatedAt.ToString("dd MMM, HH:mm", CultureInfo.InvariantCulture)</small>
                    </div>
                }
            </div>
        }
        <a asp-controller="Notifications" asp-action="Index" class="notification-view-all">View all</a>
    </div>
</details>
