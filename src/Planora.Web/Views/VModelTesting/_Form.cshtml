@model Planora.Web.ViewModels.VModel.VModelTestCaseFormViewModel
@using Planora.Domain.Enums
<div asp-validation-summary="ModelOnly" class="v3-alert"></div><div class="project-form-v3-grid"><div class="project-form-v3-field project-form-v3-wide artifact-v3-id"><label>Test Case ID</label><strong>@Model.Identifier</strong><small>Generated and protected by the server.</small></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Title"></label><input asp-for="Title" maxlength="200"/><span asp-validation-for="Title"></span></div><div class="project-form-v3-field"><label asp-for="TestLevel">Test Level</label><select asp-for="TestLevel" asp-items="Html.GetEnumSelectList<VModelTestLevel>()"></select></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Description"></label><textarea asp-for="Description" rows="5" maxlength="3000"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Preconditions"></label><textarea asp-for="Preconditions" rows="4" maxlength="2000"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="TestSteps">Test Steps</label><textarea asp-for="TestSteps" rows="8" maxlength="5000"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="ExpectedResult">Expected Result</label><textarea asp-for="ExpectedResult" rows="5" maxlength="3000"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label>Implementation Artifacts</label><div class="requirements-v3-fr-picker" data-artifact-picker><input type="search" data-artifact-search placeholder="Search implementation artifacts..." aria-label="Search implementation artifacts"/><div class="requirements-v3-fr-options">@foreach(var o in Model.ImplementationOptions){<label data-artifact-option><input type="checkbox" name="ImplementationArtifactIds" value="@o.Id" checked="@(Model.ImplementationArtifactIds.Contains(o.Id))"/><span><strong>@o.Identifier</strong> &mdash; @o.Title</span></label>}</div></div></div></div>
