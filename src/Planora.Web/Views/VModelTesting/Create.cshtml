@model Planora.Web.ViewModels.VModel.VModelTestCaseFormViewModel
@{ViewData["Title"]="New Test Case";Layout="_AppLayout";}
@section Styles{<link rel="stylesheet" href="~/css/projects.css"/><link rel="stylesheet" href="~/css/requirements.css"/>}<div class="project-form-v3-page"><div class="project-form-v3-back"><a asp-action="Index" asp-route-projectId="@Model.ProjectId">&larr; Back to testing</a></div><section class="project-form-v3-header"><span class="projects-v3-kicker">V-MODEL TESTING</span><h1>New test case</h1><p>@Model.ProjectName</p></section><form class="requirements-form-v3 project-form-v3" method="post" data-single-submit>@Html.AntiForgeryToken()<input asp-for="ProjectId" type="hidden"/><input asp-for="Id" type="hidden"/><section class="project-form-v3-panel"><partial name="_Form" model="Model"/></section><div class="project-form-v3-actions"><a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="detail-v3-secondary">Cancel</a><button class="project-form-v3-submit">Create test case</button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/task-collaboration.js"></script><script src="~/js/artifact-form.js"></script>}
