@model Planora.Web.ViewModels.VModel.VModelTestingIndexViewModel
@using Planora.Domain.Enums
@{ViewData["Title"]="V-Model Testing";Layout="_AppLayout";}
@section Styles{<link rel="stylesheet" href="~/css/projects.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/requirements.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/vmodel-testing.css" asp-append-version="true"/>}
<div class="projects-v3-page"><div class="project-form-v3-back"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Overview.ProjectId">&larr; Back to project</a></div>
@if(Model.IsReadOnly){<div class="v3-alert">V-Model testing is read-only because this project is archived.</div>}
<section class="projects-v3-header"><div><span class="projects-v3-kicker">V-MODEL</span><h1>Testing</h1><p>@Model.Overview.ProjectName</p></div><div class="requirements-v3-header-actions"><a asp-action="Validation" asp-route-projectId="@Model.Overview.ProjectId" class="detail-v3-secondary">Validation</a>@if(Model.CanManageTests){<a asp-action="Create" asp-route-projectId="@Model.Overview.ProjectId" class="project-form-v3-submit">+ Test case</a>}</div></section>
<section class="project-form-v3-panel"><div class="project-form-v3-panel-head"><div><span>PHASES</span><h2>V-Model sequence</h2></div>@if(Model.CanManagePhases&&Model.Overview.Phases.Count==0){<form asp-action="InitializePhases" method="post" data-single-submit>@Html.AntiForgeryToken()<input type="hidden" name="projectId" value="@Model.Overview.ProjectId"/><button type="submit" class="project-form-v3-submit">Initialize phases</button></form>}</div><div class="phase-v3-grid">@foreach(var phase in Model.Overview.Phases){<article><strong>@phase.PhaseOrder. @phase.PhaseType</strong><span class="projects-v3-status">@phase.Status</span>@if(Model.CanManagePhases&&phase.Status!=VModelPhaseStatus.Completed){<form asp-action="TransitionPhase" method="post" data-single-submit>@Html.AntiForgeryToken()<input type="hidden" name="ProjectId" value="@Model.Overview.ProjectId"/><input type="hidden" name="PhaseId" value="@phase.Id"/><input type="hidden" name="ExpectedStatus" value="@phase.Status"/><input type="hidden" name="TargetStatus" value="@(phase.Status==VModelPhaseStatus.NotStarted?VModelPhaseStatus.InProgress:VModelPhaseStatus.Completed)"/><button class="backlog-action backlog-action-edit">@(phase.Status==VModelPhaseStatus.NotStarted?"Start":"Complete")</button></form>}</article>}</div></section>
<section class="projects-v3-panel"><div class="projects-v3-toolbar"><div><h2>Test cases</h2><span>@Model.TestCases.Count cases</span></div><form method="get" class="requirement-v3-filters"><input type="hidden" name="projectId" value="@Model.Overview.ProjectId"/><select name="testLevel" aria-label="Test level"><option value="">All levels</option>@foreach(var v in Enum.GetValues<VModelTestLevel>()){<option value="@v" selected="@(Model.TestLevel==v)">@v</option>}</select><select name="latestResult" aria-label="Latest result"><option value="">All results</option>@foreach(var v in Enum.GetValues<VModelTestResult>()){<option value="@v" selected="@(Model.LatestResult==v)">@v</option>}</select><label><input type="checkbox" name="notExecuted" value="true" checked="@Model.NotExecuted"/> Not Executed</label><button class="backlog-action backlog-action-edit">Filter</button></form></div>
@if(Model.TestCases.Count==0){<div class="projects-v3-empty"><strong>No test cases found</strong><p>Create a test case linked to an implementation artifact.</p></div>}else{<div class="artifact-v3-links">@foreach(var t in Model.TestCases){<a asp-action="Details" asp-route-projectId="@t.ProjectId" asp-route-id="@t.Id"><strong>@t.Identifier</strong><span>@t.Title &mdash; @t.TestLevel</span><em>@(t.LatestResult?.ToString()??"Not Executed")</em></a>}</div>}</section></div>
@section Scripts{<script src="~/js/task-collaboration.js" asp-append-version="true"></script>}
