@model Planora.Web.ViewModels.VModel.VModelValidationViewModel
@using Planora.Domain.Enums
@using System.Globalization
@{ViewData["Title"]="V-Model Validation";Layout="_AppLayout";}
@section Styles{<link rel="stylesheet" href="~/css/projects.css"/><link rel="stylesheet" href="~/css/requirements.css"/>}<div class="projects-v3-page"><div class="project-form-v3-back"><a asp-action="Index" asp-route-projectId="@Model.Overview.ProjectId">&larr; Back to testing</a></div><section class="projects-v3-header"><div><span class="projects-v3-kicker">V-MODEL</span><h1>Phase Validation</h1><p>@Model.Overview.ProjectName</p></div></section><section class="projects-v3-panel">@if(!Model.Overview.Phases.Any(x=>x.Status==VModelPhaseStatus.Completed)){<div class="projects-v3-empty"><strong>No completed V-Model phases are available for validation.</strong></div>}else{@foreach(var p in Model.Overview.Phases.Where(x=>x.Status==VModelPhaseStatus.Completed)){<article class="validation-v3-phase"><div><strong>@p.PhaseType</strong><span class="projects-v3-status">@p.Status</span><span>Latest: @(p.LatestValidationResult?.ToString()??"No Validation")</span></div>@if(Model.CanValidate){<form asp-action="Validate" method="post" data-single-submit>@Html.AntiForgeryToken()<input type="hidden" name="ProjectId" value="@Model.Overview.ProjectId"/><input type="hidden" name="PhaseId" value="@p.Id"/><select name="Result" asp-items="Html.GetEnumSelectList<VModelValidationResult>()" aria-label="Validation result"></select><textarea name="Notes" maxlength="3000" required placeholder="Validation notes" aria-label="Validation notes"></textarea><button class="project-form-v3-submit">Save Validation Result</button></form>}<div><h3>Validation History</h3>@if(p.Validations.Count==0){<p>No validation records.</p>}@foreach(var v in p.Validations){<p><strong>@v.Result</strong> &mdash; @v.ValidatedAt.ToString("dd MMM yyyy HH:mm",CultureInfo.InvariantCulture) &mdash; @v.ValidatorName<br/>@v.Notes</p>}</div></article>}}</section></div>
@section Scripts{<script src="~/js/task-collaboration.js"></script>}
