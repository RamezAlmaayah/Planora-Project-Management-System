@model Planora.Web.ViewModels.VModel.VModelTestCaseDetailsViewModel
@using Planora.Domain.Enums
@using System.Globalization
@{ViewData["Title"]=Model.TestCase.Title;Layout="_AppLayout";}
@section Styles{<link rel="stylesheet" href="~/css/projects.css"/><link rel="stylesheet" href="~/css/requirements.css"/>}<div class="project-detail-v3"><div class="detail-v3-back"><a asp-action="Index" asp-route-projectId="@Model.TestCase.ProjectId">&larr; Back to testing</a></div>@if(TempData["SuccessMessage"] is string s){<div class="v3-alert v3-alert-success">@s</div>}<section class="detail-v3-header"><div class="detail-v3-heading"><span class="projects-v3-method">@Model.TestCase.TestLevel</span><h1>@Model.TestCase.Identifier &mdash; @Model.TestCase.Title</h1><p>@Model.TestCase.ProjectName</p></div>@if(Model.CanEdit){<a asp-action="Edit" asp-route-projectId="@Model.TestCase.ProjectId" asp-route-id="@Model.TestCase.Id" class="detail-v3-secondary">Edit test case</a>}</section>
<section class="project-form-v3-panel"><div class="project-form-v3-panel-head"><div><span>TEST CASE</span><h2>Test definition</h2></div></div><div class="requirements-v3-section-body"><h3>Description</h3><p>@Model.TestCase.Description</p><h3>Preconditions</h3><p>@(Model.TestCase.Preconditions??"None")</p><h3>Test Steps</h3><p class="artifact-v3-copy">@Model.TestCase.TestSteps</p><h3>Expected Result</h3><p>@Model.TestCase.ExpectedResult</p></div></section>
<section class="project-form-v3-panel"><div class="project-form-v3-panel-head"><div><span>TRACEABILITY</span><h2>Artifact chain</h2></div></div><div class="requirements-v3-section-body"><h3>Implementation Artifacts</h3><div class="artifact-v3-links">@foreach(var x in Model.TestCase.Implementations){<a asp-controller="ImplementationArtifacts" asp-action="Details" asp-route-projectId="@Model.TestCase.ProjectId" asp-route-id="@x.Id"><strong>@x.Identifier</strong><span>@x.Title</span></a>}</div><h3>Derived Designs</h3><div class="artifact-v3-links">@foreach(var x in Model.TestCase.Designs){<a asp-controller="DesignArtifacts" asp-action="Details" asp-route-projectId="@Model.TestCase.ProjectId" asp-route-id="@x.Id"><strong>@x.Identifier</strong><span>@x.Title</span></a>}</div><h3>Derived Requirements</h3><div class="artifact-v3-links">@foreach(var x in Model.TestCase.Requirements){<a asp-controller="Requirements" asp-action="Details" asp-route-projectId="@Model.TestCase.ProjectId" asp-route-id="@x.Id"><strong>@x.Identifier</strong><span>@x.Title</span><em>@x.Status</em></a>}</div></div></section>
@if(Model.CanExecute){<section class="project-form-v3-panel"><div class="project-form-v3-panel-head"><div><span>VERIFICATION</span><h2>Execute Test</h2></div></div><form asp-action="Execute" method="post" class="requirements-v3-trace-form" data-single-submit>@Html.AntiForgeryToken()<input type="hidden" name="ProjectId" value="@Model.TestCase.ProjectId"/><input type="hidden" name="TestCaseId" value="@Model.TestCase.Id"/><div><label>Test Case</label><strong>@Model.TestCase.Identifier</strong></div><div><label>Expected Result</label><strong>@Model.TestCase.ExpectedResult</strong></div><div><label for="test-execution-result">Result</label><select id="test-execution-result" name="Result" asp-items="Html.GetEnumSelectList<VModelTestResult>()"></select></div><div class="requirements-v3-trace-description"><label for="test-actual-result">Actual Result</label><textarea id="test-actual-result" name="ActualResult" maxlength="3000" required></textarea></div><div class="requirements-v3-trace-description"><label for="test-execution-notes">Notes</label><textarea id="test-execution-notes" name="Notes" maxlength="3000"></textarea></div><button class="project-form-v3-submit">Save execution</button></form></section>}
<section class="project-form-v3-panel"><div class="project-form-v3-panel-head"><div><span>HISTORY</span><h2>Execution History</h2></div></div><div class="requirements-v3-section-body">@if(Model.TestCase.Executions.Count==0){<p>No executions yet. Not Executed.</p>}@foreach(var e in Model.TestCase.Executions){<article class="execution-v3-row"><strong>@e.Result</strong><span>@e.ExecutedAt.ToString("dd MMM yyyy HH:mm",CultureInfo.InvariantCulture) by @e.ExecutorName</span><p>@e.ActualResult</p>@if(e.Issues.Count>0){<span>Issues: @string.Join(", ",e.Issues.Select(x=>x.Title))</span>}@if(e.Result==VModelTestResult.Fail&&Model.CanExecute){<a asp-controller="Issues" asp-action="Create" asp-route-projectId="@Model.TestCase.ProjectId" asp-route-testExecutionId="@e.Id" class="detail-v3-secondary">Report Issue</a>}</article>}</div></section></div>
@section Scripts{<script src="~/js/task-collaboration.js"></script>}
