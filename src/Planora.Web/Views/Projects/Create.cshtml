@model Planora.Web.ViewModels.Projects.ProjectFormViewModel
@using Planora.Domain.Enums

@{
    ViewData["Title"] = "Create Project";
    Layout = "_AppLayout";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/projects.css"
          asp-append-version="true" />
}

<div class="project-form-v3-page">

    <!-- =====================================================
         BACK
         ===================================================== -->

    <div class="project-form-v3-back">

        <a asp-controller="Projects"
           asp-action="Index">
            ← Back to projects
        </a>

    </div>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <section class="project-form-v3-header">

        <div>

            <span class="project-form-v3-kicker">
                PROJECT MANAGEMENT
            </span>

            <h1>
                Create project
            </h1>

            <p>
                Set up the basic project information, methodology and planned timeline.
            </p>

        </div>

       

    </section>


    <!-- =====================================================
         FORM
         ===================================================== -->

    <form asp-controller="Projects"
          asp-action="Create"
          method="post"
          class="project-form-v3">

        <input asp-for="Status"
               type="hidden" />


        <!-- VALIDATION -->

        <div asp-validation-summary="ModelOnly"
             class="project-form-v3-validation">
        </div>


        <!-- =================================================
             BASIC INFORMATION
             ================================================= -->

        <section class="project-form-v3-panel">

            <div class="project-form-v3-panel-head">

                <div class="project-form-v3-panel-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 6.5A2.5 2.5 0 0 1 5.5 4H9l2 2h7.5A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5Z" />

                        <path d="M3 9h18" />

                    </svg>

                </div>

                <div>

                    <span>
                        PROJECT DETAILS
                    </span>

                    <h2>
                        Basic information
                    </h2>

                    <p>
                        Add the primary information that identifies this project.
                    </p>

                </div>

            </div>


            <div class="project-form-v3-fields">

                <!-- NAME -->

                <div class="project-form-v3-field project-form-v3-full">

                    <label asp-for="Name">
                        Project name
                    </label>

                    <input asp-for="Name"
                           placeholder="Example: Planora Development Project"
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="project-form-v3-error">
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="project-form-v3-field project-form-v3-full">

                    <div class="project-form-v3-label-row">

                        <label asp-for="Description">
                            Description
                        </label>

                        <span>
                            Project overview
                        </span>

                    </div>

                    <textarea asp-for="Description"
                              rows="6"
                              placeholder="Describe the project's purpose, goals and main idea..."></textarea>

                    <span asp-validation-for="Description"
                          class="project-form-v3-error">
                    </span>

                </div>

            </div>

        </section>


        <!-- =================================================
             PROJECT CONFIGURATION
             ================================================= -->

        <section class="project-form-v3-panel">

            <div class="project-form-v3-panel-head">

                <div class="project-form-v3-panel-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12"
                                cy="12"
                                r="3" />

                        <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.1A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15" />

                    </svg>

                </div>

                <div>

                    <span>
                        CONFIGURATION
                    </span>

                    <h2>
                        Project setup
                    </h2>

                    <p>
                        Choose the project methodology and review its initial status.
                    </p>

                </div>

            </div>


            <div class="project-form-v3-fields project-form-v3-two-columns">

                <!-- METHODOLOGY -->

                <div class="project-form-v3-field">

                    <label asp-for="Methodology">
                        Methodology
                    </label>

                    <div class="project-form-v3-select-wrap">

                        <select asp-for="Methodology"
                                asp-items="Html.GetEnumSelectList<ProjectMethodology>()">
                        </select>

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="m7 10 5 5 5-5" />

                        </svg>

                    </div>

                    <span asp-validation-for="Methodology"
                          class="project-form-v3-error">
                    </span>

                </div>


                <!-- INITIAL STATUS -->

                <div class="project-form-v3-field">

                    <label>
                        Initial status
                    </label>

                    <div class="project-form-v3-readonly">

                        <span class="project-form-v3-status-dot"></span>

                        <div>

                            <strong>
                                Planning
                            </strong>

                            <small>
                                New projects start in Planning status.
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             TIMELINE
             ================================================= -->

        <section class="project-form-v3-panel">

            <div class="project-form-v3-panel-head">

                <div class="project-form-v3-panel-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="3"
                              y="5"
                              width="18"
                              height="16"
                              rx="2" />

                        <path d="M16 3v4" />

                        <path d="M8 3v4" />

                        <path d="M3 11h18" />

                    </svg>

                </div>

                <div>

                    <span>
                        TIMELINE
                    </span>

                    <h2>
                        Project schedule
                    </h2>

                    <p>
                        Define when the project starts and its expected completion date.
                    </p>

                </div>

            </div>


            <div class="project-form-v3-fields project-form-v3-two-columns">

                <!-- START DATE -->

                <div class="project-form-v3-field">

                    <label asp-for="StartDate">
                        Start date
                    </label>

                    <input asp-for="StartDate"
                           type="date" />

                    <span asp-validation-for="StartDate"
                          class="project-form-v3-error">
                    </span>

                </div>


                <!-- END DATE -->

                <div class="project-form-v3-field">

                    <div class="project-form-v3-label-row">

                        <label asp-for="EndDate">
                            End date
                        </label>

                        <span>
                            Optional
                        </span>

                    </div>

                    <input asp-for="EndDate"
                           type="date" />

                    <span asp-validation-for="EndDate"
                          class="project-form-v3-error">
                    </span>

                </div>

            </div>

        </section>


        <!-- =================================================
             ACTIONS
             ================================================= -->

        <div class="project-form-v3-actions">

            <a asp-controller="Projects"
               asp-action="Index"
               class="project-form-v3-cancel">

                Cancel

            </a>


            <button type="submit"
                    class="project-form-v3-submit">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round">

                    <path d="M12 5v14" />

                    <path d="M5 12h14" />

                </svg>

                Create project

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}