@model Planora.Web.ViewModels.Projects.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Archive Project";
    Layout = "_AppLayout";

    string methodology =
        Model.Methodology.ToString() == "VModel"
            ? "V-Model"
            : Model.Methodology.ToString();
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/projects.css"
          asp-append-version="true" />
}

<div class="archive-v3-page">

    <!-- =====================================================
         BACK
         ===================================================== -->

    <div class="archive-v3-back">

        <a asp-controller="Projects"
           asp-action="Details"
           asp-route-id="@Model.Id">
            ← Back to project
        </a>

    </div>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <section class="archive-v3-header">

        <span class="archive-v3-kicker">
            PROJECT ARCHIVE
        </span>

        <h1>
            Archive project
        </h1>

        <p>
            Review the project information before moving it to the archive.
        </p>

    </section>


    <!-- =====================================================
         ARCHIVE PANEL
         ===================================================== -->

    <section class="archive-v3-panel">

        <div class="archive-v3-warning">

            <div class="archive-v3-warning-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 9v4" />

                    <path d="M12 17h.01" />

                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />

                </svg>

            </div>

            <div>

                <span>
                    CONFIRM ARCHIVE
                </span>

                <h2>
                    Archive @Model.Name?
                </h2>

                <p>
                    This project will be changed to
                    <strong>Archived</strong>.
                    It will remain available for historical reference,
                    but project editing and membership changes will be disabled.
                </p>

            </div>

        </div>


        <!-- =================================================
             PROJECT SUMMARY
             ================================================= -->

        <div class="archive-v3-summary">

            <article>

                <span>
                    Project
                </span>

                <strong>
                    @Model.Name
                </strong>

            </article>


            <article>

                <span>
                    Methodology
                </span>

                <strong>
                    @methodology
                </strong>

            </article>


            <article>

                <span>
                    Current status
                </span>

                <strong>
                    @Model.Status
                </strong>

            </article>


            <article>

                <span>
                    Members
                </span>

                <strong>
                    @Model.MemberCount
                </strong>

            </article>

        </div>


        <!-- =================================================
             NOTE
             ================================================= -->

        <div class="archive-v3-note">

            <div class="archive-v3-note-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <path d="M12 11v5" />

                    <path d="M12 8h.01" />

                </svg>

            </div>

            <div>

                <strong>
                    What happens after archiving?
                </strong>

                <p>
                    The project remains visible for historical reference,
                    while editing and team membership changes become read-only.
                </p>

            </div>

        </div>


        <!-- =================================================
             ACTIONS
             ================================================= -->

        <div class="archive-v3-actions">

            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="archive-v3-cancel">
                Cancel
            </a>


            <form asp-controller="Projects"
                  asp-action="Archive"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit"
                        class="archive-v3-confirm">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 6h18" />

                        <path d="M8 6V4h8v2" />

                        <path d="M19 6l-1 14H6L5 6" />

                        <path d="M10 11v5" />

                        <path d="M14 11v5" />

                    </svg>

                    Archive project

                </button>

            </form>

        </div>

    </section>

</div>