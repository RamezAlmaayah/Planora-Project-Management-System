@model Planora.Web.ViewModels.VModel.DesignArtifactFormViewModel
@{ ViewData["Title"] = "Edit Design Artifact"; Layout = "_AppLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/requirements.css" asp-append-version="true" /> }
<div class="project-form-v3-page">
    <div class="project-form-v3-back"><a asp-action="Details" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.Id">&larr; Back to design</a></div>
    <section class="project-form-v3-header"><span class="projects-v3-kicker">V-MODEL DESIGN</span><h1>Edit @Model.Identifier</h1><p>@Model.ProjectName</p></section>
    <form class="requirements-form-v3 project-form-v3" asp-action="Edit" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.Id" method="post" data-single-submit>
        @Html.AntiForgeryToken()<input asp-for="ProjectId" type="hidden" /><input asp-for="Id" type="hidden" />
        <section class="project-form-v3-panel"><partial name="_Form" model="Model" /></section>
        <div class="project-form-v3-actions"><a asp-action="Details" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.Id" class="detail-v3-secondary">Cancel</a><button class="project-form-v3-submit" type="submit">Save design</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/task-collaboration.js" asp-append-version="true"></script><script src="~/js/artifact-form.js" asp-append-version="true"></script> }
