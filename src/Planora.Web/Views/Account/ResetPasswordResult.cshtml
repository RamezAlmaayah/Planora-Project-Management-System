@model bool

@{
    ViewData["Title"] = "Password Reset";
    Layout = "_AuthLayout";

    var resultKicker = Model
        ? "PASSWORD UPDATED"
        : "RESET LINK INVALID";

    var resultTitle = Model
        ? "Password updated"
        : "Reset link invalid";

    var resultDescription = Model
        ? "Your Planora password has been changed successfully. You can now sign in using your new password."
        : "This password reset link is invalid, expired, or has already been used.";

    var buttonText = Model
        ? "Continue to sign in"
        : "Request new reset link";
}

<div class="auth-v3-shell"
     data-auth-page="reset-result">

    <!-- =====================================================
         LEFT SIDE
         ===================================================== -->

    <section class="auth-v3-showcase">

        <div class="auth-v3-brand">

            <div class="auth-v3-brand-icon auth-v3-brand-logo-box">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="auth-v3-brand-logo" />
</div>

<span>Planora</span>

        </div>


        <div class="auth-v3-showcase-content">

            <span class="auth-v3-kicker">
                SECURE PASSWORD RECOVERY
            </span>

            <h1>
                Reset. Protect. Continue.
            </h1>

            <p>
                Keep your Planora account protected with secure
                password recovery and controlled access to your
                projects, teams and workspace.
            </p>


            <div class="auth-v3-features">

                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="11"
                                  rx="2" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Secure password
                        </strong>

                        <span>
                            Protect your account with strong credentials.
                        </span>

                    </div>

                </article>


                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />

                            <path d="m9 12 2 2 4-4" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Protected recovery
                        </strong>

                        <span>
                            Password reset links use secure tokens.
                        </span>

                    </div>

                </article>


                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M5 12h14" />

                            <path d="m14 7 5 5-5 5" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Return to Planora
                        </strong>

                        <span>
                            Continue securely to your workspace.
                        </span>

                    </div>

                </article>

            </div>

        </div>


        <div class="auth-v3-showcase-footer">
            Secure project management with Planora.
        </div>

    </section>


    <!-- =====================================================
         RESULT SIDE
         ===================================================== -->

    <section class="auth-v3-form-side">

        <div class="auth-v3-form-wrapper">

            <div class="auth-v3-mobile-brand">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="auth-v3-mobile-logo" />
    <span>Planora</span>
</div>


            <div class="auth-v3-result">

                <div class="auth-v3-result-icon">

                    @if (Model)
                    {
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.9"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9" />

                            <path d="m8 12 2.7 2.7L16.5 9" />

                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.9"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9" />

                            <path d="M12 8v5" />

                            <path d="M12 17h.01" />

                        </svg>
                    }

                </div>


                <span class="auth-v3-result-kicker">
                    @resultKicker
                </span>


                <h2>
                    @resultTitle
                </h2>


                <p>
                    @resultDescription
                </p>


                @if (Model)
                {
                    <div class="auth-v3-result-note">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9" />

                            <path d="m8 12 2.7 2.7L16.5 9" />

                        </svg>

                        <span>
                            Your new password is active.
                            Use it the next time you sign in to Planora.
                        </span>

                    </div>
                }
                else
                {
                    <div class="auth-v3-result-note">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9" />

                            <path d="M12 8v4" />

                            <path d="M12 16h.01" />

                        </svg>

                        <span>
                            For your security, request a new password
                            reset link before trying again.
                        </span>

                    </div>
                }


                @if (Model)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="auth-v3-submit auth-v3-result-button">

                        @buttonText

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.9"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M5 12h14" />
                            <path d="m14 7 5 5-5 5" />

                        </svg>

                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="auth-v3-submit auth-v3-result-button">

                        @buttonText

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.9"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M5 12h14" />
                            <path d="m14 7 5 5-5 5" />

                        </svg>

                    </a>
                }

            </div>

        </div>

    </section>

</div>
