@model Planora.Web.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-v3-shell"
     data-auth-page="reset-password">

    <!-- =====================================================
         LEFT SIDE
         ===================================================== -->

    <section class="auth-v3-showcase">

        <div class="auth-v3-brand">

            <div class="auth-v3-brand-icon auth-v3-brand-logo-box">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="auth-v3-brand-logo" />
</div>

<span>Planora</span>

        </div>


        <div class="auth-v3-showcase-content">

            <span class="auth-v3-kicker">
                SECURE PASSWORD RESET
            </span>

            <h1>
                Secure. Reset. Return.
            </h1>

            <p>
                Create a new secure password for your Planora account
                and return safely to your project workspace.
            </p>


            <div class="auth-v3-features">

                <!-- STRONG PASSWORD -->

                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="11"
                                  rx="2" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Strong password
                        </strong>

                        <span>
                            Use at least 10 secure characters.
                        </span>

                    </div>

                </article>


                <!-- COMPLEXITY -->

                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M4 12h16" />
                            <path d="M12 4v16" />
                            <circle cx="12"
                                    cy="12"
                                    r="9" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Password complexity
                        </strong>

                        <span>
                            Uppercase, lowercase, number and symbol.
                        </span>

                    </div>

                </article>


                <!-- PROTECTED -->

                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />

                            <path d="m9 12 2 2 4-4" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Protected reset
                        </strong>

                        <span>
                            Secured with a temporary reset token.
                        </span>

                    </div>

                </article>

            </div>

        </div>


        <div class="auth-v3-showcase-footer">
            Secure project management with Planora.
        </div>

    </section>


    <!-- =====================================================
         FORM SIDE
         ===================================================== -->

    <section class="auth-v3-form-side">

        <div class="auth-v3-form-wrapper">

            <div class="auth-v3-mobile-brand">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="auth-v3-mobile-logo" />
    <span>Planora</span>
</div>


            <header class="auth-v3-form-header">

                <span>
                    NEW PASSWORD
                </span>

                <h2>
                    Create new password
                </h2>

                <p>
                    Choose a strong password for your Planora account.
                </p>

            </header>


            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post"
                  class="auth-v3-form">

                @Html.AntiForgeryToken()

                <!-- Keep reset information hidden -->
                <input asp-for="Email"
                       type="hidden" />

                <input asp-for="Code"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="auth-v3-validation">
                </div>


                <!-- NEW PASSWORD -->

                <div class="auth-v3-field">

                    <label asp-for="Password">
                        New password
                    </label>

                    <div class="auth-v3-input-wrap">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="11"
                                  rx="2" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                        </svg>

                        <input asp-for="Password"
                               autocomplete="new-password"
                               placeholder="Enter your new password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="auth-v3-field-error">
                    </span>

                    <div class="auth-v3-password-hint">
                        At least 10 characters with uppercase,
                        lowercase, number and special character.
                    </div>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="auth-v3-field">

                    <label asp-for="ConfirmPassword">
                        Confirm password
                    </label>

                    <div class="auth-v3-input-wrap">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="11"
                                  rx="2" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                            <path d="m9.5 15 1.7 1.7 3.4-3.4" />

                        </svg>

                        <input asp-for="ConfirmPassword"
                               autocomplete="new-password"
                               placeholder="Confirm your new password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="auth-v3-field-error">
                    </span>

                </div>


                <!-- RESET BUTTON -->

                <button type="submit"
                        class="auth-v3-submit">

                    Reset password

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.9"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12h14" />

                        <path d="m14 7 5 5-5 5" />

                    </svg>

                </button>


                <!-- BACK TO LOGIN -->

                <div class="auth-v3-switch">

                    <a asp-controller="Account"
                       asp-action="Login">
                        Back to sign in
                    </a>

                </div>

            </form>

        </div>

    </section>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
