@model Planora.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-v3-shell"
     data-auth-page="forgot">

    <!-- =====================================================
         LEFT SIDE
         ===================================================== -->

    <section class="auth-v3-showcase">

        <div class="auth-v3-brand">

            <div class="auth-v3-brand-icon auth-v3-brand-logo-box">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="auth-v3-brand-logo" />
</div>

<span>Planora</span>

        </div>


        <div class="auth-v3-showcase-content">

            <span class="auth-v3-kicker">
                SECURE ACCOUNT RECOVERY
            </span>

            <h1>
                Recover. Reset. Continue.
            </h1>

            <p>
                Enter your account email to request a secure reset link
                and return to your Planora workspace.
            </p>


            <div class="auth-v3-features">

                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3"
                                  y="5"
                                  width="18"
                                  height="14"
                                  rx="2" />

                            <path d="m3 7 9 6 9-6" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Check your inbox
                        </strong>

                        <span>
                            Look for the Planora reset email.
                        </span>

                    </div>

                </article>


                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />

                            <path d="m9 12 2 2 4-4" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Secure reset link
                        </strong>

                        <span>
                            Your reset request uses a protected token.
                        </span>

                    </div>

                </article>


                <article>

                    <div class="auth-v3-feature-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M5 12h14" />

                            <path d="m14 7 5 5-5 5" />

                        </svg>

                    </div>

                    <div>

                        <strong>
                            Return securely
                        </strong>

                        <span>
                            Create a new password and sign in again.
                        </span>

                    </div>

                </article>

            </div>

        </div>


        <div class="auth-v3-showcase-footer">
            Secure project management with Planora.
        </div>

    </section>


    <!-- =====================================================
         FORM SIDE
         ===================================================== -->

    <section class="auth-v3-form-side">

        <div class="auth-v3-form-wrapper">

            <div class="auth-v3-mobile-brand">
    <img src="~/images/brand/planora-logo.png"
         asp-append-version="true"
         alt="Planora"
         class="auth-v3-mobile-logo" />
    <span>Planora</span>
</div>


            <header class="auth-v3-form-header">
                <span>SECURE ACCOUNT RECOVERY</span>
                <h2>Forgot your password?</h2>
                <p>Enter your email address to request a password reset link.</p>
            </header>

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  class="auth-v3-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="auth-v3-validation"></div>

                <div class="auth-v3-field">
                    <label asp-for="Email"></label>
                    <div class="auth-v3-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m3 7 9 6 9-6" />
                        </svg>
                        <input asp-for="Email" autocomplete="email" placeholder="Enter your email" />
                    </div>
                    <span asp-validation-for="Email" class="auth-v3-field-error"></span>
                </div>

                <button type="submit" class="auth-v3-submit">
                    Send reset link
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" />
                        <path d="m14 7 5 5-5 5" />
                    </svg>
                </button>
            </form>

            <div class="auth-v3-switch">
                <a asp-controller="Account" asp-action="Login">Back to sign in</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
