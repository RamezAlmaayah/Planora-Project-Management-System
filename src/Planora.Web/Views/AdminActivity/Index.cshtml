@model Planora.Web.ViewModels.AdminActivity.AdminActivityViewModel
@{
    ViewData["Title"] = "Activity & Presence";
    Layout = "_AppLayout";
}
<div class="projects-v3-page admin-activity-page" data-admin-presence data-snapshot-url="@Url.Action("PresenceSnapshot", "AdminActivity")">
    <section class="projects-v3-header">
        <div><span class="projects-v3-kicker">ADMINISTRATION</span><h1>Activity &amp; Presence</h1><p>Read-only application activity and current authenticated user presence.</p></div>
        <span class="projects-v3-method">Admin only</span>
    </section>

    <section class="projects-v3-panel">
        <div class="projects-v3-toolbar"><div><h2>Application activity</h2><p>@Model.TotalCount events · Page @Model.Page of @Model.TotalPages</p></div></div>
        <form method="get" class="admin-activity-filters">
            <label>User<select name="userId"><option value="">All users</option>@foreach (var user in Model.Users) { <option value="@user.Id" selected="@(Model.UserId == user.Id)">@user.Name</option> }</select></label>
            <label>Project<select name="projectId"><option value="">All projects</option>@foreach (var project in Model.Projects) { <option value="@project.Id" selected="@(Model.ProjectId == project.Id)">@project.Name</option> }</select></label>
            <label>Action<select name="action"><option value="">All actions</option>@foreach (var action in Model.Actions) { <option value="@action" selected="@(Model.Action == action)">@action</option> }</select></label>
            <label>From<input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></label>
            <label>To<input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></label>
            <button type="submit" class="backlog-action backlog-action-edit">Filter</button>
        </form>
        @if (Model.Entries.Count == 0)
        {
            <div class="projects-v3-empty"><strong>No activity found</strong><p>Change the selected filters to see more records.</p></div>
        }
        else
        {
            <div class="admin-activity-table-wrap"><table class="admin-activity-table">
                <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Resource</th><th>Project</th></tr></thead>
                <tbody>@foreach (var entry in Model.Entries) { <tr><td>@entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@entry.Actor</td><td>@entry.Action</td><td>@entry.ResourceType #@entry.ResourceId</td><td>@(entry.ProjectName ?? "—")</td></tr> }</tbody>
            </table></div>
            @if (Model.TotalPages > 1)
            {
                <nav class="admin-activity-pagination" aria-label="Activity pages">
                    @if (Model.Page > 1) { <a asp-action="Index" asp-route-userId="@Model.UserId" asp-route-projectId="@Model.ProjectId" asp-route-action="@Model.Action" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page - 1)">Previous</a> }
                    @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-userId="@Model.UserId" asp-route-projectId="@Model.ProjectId" asp-route-action="@Model.Action" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page + 1)">Next</a> }
                </nav>
            }
        }
    </section>

    <section class="projects-v3-panel admin-presence-panel">
        <div class="projects-v3-toolbar"><div><h2>User presence</h2><p data-presence-connection role="status">Connecting to live presence…</p></div></div>
        <div class="admin-activity-table-wrap"><table class="admin-activity-table"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last seen</th></tr></thead>
            <tbody data-presence-rows>@foreach (var person in Model.Presence) { <tr><td>@person.Name</td><td>@person.Role</td><td>@(person.Online ? "Online" : "Offline")</td><td>@(person.Online ? "—" : person.LastSeenAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Never")</td></tr> }</tbody>
        </table></div>
    </section>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-activity.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-presence.js" asp-append-version="true"></script>
}
