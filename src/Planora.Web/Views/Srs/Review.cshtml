@model Planora.Web.ViewModels.Srs.SrsReviewViewModel
@{ ViewData["Title"] = "Review SRS Draft"; Layout = "_AppLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/requirements.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/srs.css" asp-append-version="true" /> }
<div class="project-form-v3-page requirements-v3-page srs-v3-page">
    <div class="project-form-v3-back"><a asp-action="Index" asp-route-projectId="@Model.ProjectId">&larr; Back to SRS</a></div>
    <section class="project-form-v3-header"><span class="projects-v3-kicker">TEMPORARY DRAFT &middot; REVIEW REQUIRED</span><h1>Review SRS Draft</h1><p>@Model.ProjectName &middot; Input quality @Model.QualityScore/100 (@Model.QualityLevel)</p></section>
    <form asp-action="Save" asp-route-projectId="@Model.ProjectId" method="post" class="project-form-v3 srs-v3-review-form" data-srs-save-form>
        @Html.AntiForgeryToken()<input asp-for="ProjectId" type="hidden" /><input asp-for="DraftToken" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="v3-alert" role="alert"></div>
        <section class="project-form-v3-panel"><p class="requirements-v3-ieee-note">Requirement/SRS format aligned with IEEE standards.</p><div class="project-form-v3-field"><label asp-for="Content.DocumentTitle">Document Title</label><input asp-for="Content.DocumentTitle" /><span asp-validation-for="Content.DocumentTitle"></span></div></section>
        <section class="project-form-v3-panel"><h2>1. Introduction</h2><div class="project-form-v3-grid"><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.Purpose">Purpose</label><textarea asp-for="Content.Purpose" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.Scope">Scope</label><textarea asp-for="Content.Scope" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.DocumentOverview">Document Overview</label><textarea asp-for="Content.DocumentOverview" rows="5"></textarea></div></div></section>
        <section class="project-form-v3-panel"><h2>2. Overall Description</h2><div class="project-form-v3-grid"><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.ProductPerspective">Product Perspective</label><textarea asp-for="Content.ProductPerspective" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.ProductFunctions">Product Functions</label><textarea asp-for="Content.ProductFunctions" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.UserActorOverview">User / Actor Overview</label><textarea asp-for="Content.UserActorOverview" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.OperatingEnvironment">Operating Environment</label><textarea asp-for="Content.OperatingEnvironment" rows="4"></textarea></div></div></section>
        <section class="project-form-v3-panel"><h2>3. Actors / User Roles</h2><div class="srs-v3-edit-list">@for (int i = 0; i < Model.Content.Actors.Count; i++) { <article><div class="project-form-v3-field"><label asp-for="Content.Actors[i].Name">Actor</label><input asp-for="Content.Actors[i].Name" /></div><div class="project-form-v3-field"><label asp-for="Content.Actors[i].Description">Description</label><textarea asp-for="Content.Actors[i].Description" rows="3"></textarea></div></article> }</div></section>
        <section class="project-form-v3-panel"><h2>4. Functional Requirements</h2><div class="srs-v3-edit-list">@for (int i = 0; i < Model.Content.FunctionalRequirements.Count; i++) { <article><input asp-for="Content.FunctionalRequirements[i].Identifier" type="hidden" /><input asp-for="Content.FunctionalRequirements[i].Priority" type="hidden" /><header><span class="requirements-v3-code">@Model.Content.FunctionalRequirements[i].Identifier</span><strong>@Model.Content.FunctionalRequirements[i].Priority</strong></header><div class="project-form-v3-field"><label asp-for="Content.FunctionalRequirements[i].Name">Requirement Name</label><input asp-for="Content.FunctionalRequirements[i].Name" /></div><div class="project-form-v3-field"><label asp-for="Content.FunctionalRequirements[i].Description">Description</label><textarea asp-for="Content.FunctionalRequirements[i].Description" rows="4"></textarea></div><div class="project-form-v3-field"><label asp-for="Content.FunctionalRequirements[i].BusinessRationale">Business Rationale</label><textarea asp-for="Content.FunctionalRequirements[i].BusinessRationale" rows="3"></textarea></div><div class="project-form-v3-field"><label asp-for="Content.FunctionalRequirements[i].Preconditions">Preconditions</label><textarea asp-for="Content.FunctionalRequirements[i].Preconditions" rows="3"></textarea></div><div class="project-form-v3-field"><label asp-for="Content.FunctionalRequirements[i].ExceptionScenario">Exception Scenario</label><textarea asp-for="Content.FunctionalRequirements[i].ExceptionScenario" rows="3"></textarea></div></article> }</div></section>
        <section class="project-form-v3-panel"><h2>5. Non-Functional Requirements</h2><div class="srs-v3-edit-list">@for (int i = 0; i < Model.Content.NonFunctionalRequirements.Count; i++) { <article><input asp-for="Content.NonFunctionalRequirements[i].Identifier" type="hidden" /><input asp-for="Content.NonFunctionalRequirements[i].Category" type="hidden" /><input asp-for="Content.NonFunctionalRequirements[i].Priority" type="hidden" />@for (int r = 0; r < Model.Content.NonFunctionalRequirements[i].RelatedFunctionalRequirements.Count; r++) { <input asp-for="Content.NonFunctionalRequirements[i].RelatedFunctionalRequirements[r]" type="hidden" /> }<header><span class="requirements-v3-code">@Model.Content.NonFunctionalRequirements[i].Identifier</span><strong>@Model.Content.NonFunctionalRequirements[i].Category &middot; @Model.Content.NonFunctionalRequirements[i].Priority</strong></header><div class="project-form-v3-field"><label asp-for="Content.NonFunctionalRequirements[i].Description">Description</label><textarea asp-for="Content.NonFunctionalRequirements[i].Description" rows="4"></textarea></div><div class="project-form-v3-field"><label asp-for="Content.NonFunctionalRequirements[i].Rationale">Rationale</label><textarea asp-for="Content.NonFunctionalRequirements[i].Rationale" rows="3"></textarea></div><p>Related FRs: @(Model.Content.NonFunctionalRequirements[i].RelatedFunctionalRequirements.Count == 0 ? "Not specified." : string.Join(", ", Model.Content.NonFunctionalRequirements[i].RelatedFunctionalRequirements))</p></article> }</div></section>
        <section class="project-form-v3-panel"><h2>6-10. Supporting Requirements</h2><div class="project-form-v3-grid"><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.ExternalInterfaceRequirementsText">External Interface Requirements (one per line)</label><textarea asp-for="Content.ExternalInterfaceRequirementsText" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.DataRequirementsText">Data Requirements (one per line)</label><textarea asp-for="Content.DataRequirementsText" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.ConstraintsText">Constraints (one per line)</label><textarea asp-for="Content.ConstraintsText" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.AssumptionsAndDependenciesText">Assumptions and Dependencies (one per line)</label><textarea asp-for="Content.AssumptionsAndDependenciesText" rows="5"></textarea></div><div class="project-form-v3-field project-form-v3-wide"><label asp-for="Content.AcceptanceCriteriaText">Acceptance Criteria (one per line)</label><textarea asp-for="Content.AcceptanceCriteriaText" rows="5"></textarea></div></div></section>
        <section class="project-form-v3-panel"><h2>11. AI Input Quality Summary</h2><div class="project-form-v3-field"><label asp-for="Content.AiQualitySummary">Summary</label><textarea asp-for="Content.AiQualitySummary" rows="4"></textarea></div></section>
        <div class="project-form-v3-actions"><a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="detail-v3-secondary">Cancel</a><button type="submit" class="project-form-v3-submit" data-srs-save-button>Save SRS</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/srs.js" asp-append-version="true"></script> }
