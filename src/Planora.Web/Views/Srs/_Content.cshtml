@model Planora.Application.Common.Srs.SrsContent
<div class="srs-v3-content">
    <section><h2>1. Introduction</h2><h3>Purpose</h3><p>@Model.Introduction.Purpose</p><h3>Scope</h3><p>@Model.Introduction.Scope</p><h3>Document Overview</h3><p>@Model.Introduction.DocumentOverview</p></section>
    <section><h2>2. Overall Description</h2><h3>Product Perspective</h3><p>@Model.OverallDescription.ProductPerspective</p><h3>Product Functions</h3><p>@Model.OverallDescription.ProductFunctions</p><h3>User / Actor Overview</h3><p>@Model.OverallDescription.UserActorOverview</p><h3>Operating Environment</h3><p>@Model.OverallDescription.OperatingEnvironment</p></section>
    <section><h2>3. Actors / User Roles</h2>@if (Model.Actors.Count == 0) { <p>Not specified.</p> } else { @foreach (var actor in Model.Actors) { <article><h3>@actor.Name</h3><p>@actor.Description</p></article> } }</section>
    <section><h2>4. Functional Requirements</h2>@if (Model.FunctionalRequirements.Count == 0) { <p>Not specified.</p> } else { @foreach (var requirement in Model.FunctionalRequirements) { <article class="srs-v3-requirement"><header><span class="requirements-v3-code">@requirement.Identifier</span><strong>@requirement.Name</strong><small>@requirement.Priority</small></header><h3>Description</h3><p>@requirement.Description</p><h3>Business Rationale</h3><p>@requirement.BusinessRationale</p><h3>Preconditions</h3><p>@requirement.Preconditions</p><h3>Exception Scenario</h3><p>@requirement.ExceptionScenario</p></article> } }</section>
    <section><h2>5. Non-Functional Requirements</h2>@if (Model.NonFunctionalRequirements.Count == 0) { <p>Not specified.</p> } else { @foreach (var requirement in Model.NonFunctionalRequirements) { <article class="srs-v3-requirement"><header><span class="requirements-v3-code">@requirement.Identifier</span><strong>@requirement.Category</strong><small>@requirement.Priority</small></header><h3>Description</h3><p>@requirement.Description</p><h3>Rationale</h3><p>@requirement.Rationale</p><h3>Related Functional Requirements</h3><p>@(requirement.RelatedFunctionalRequirements.Count == 0 ? "Not specified." : string.Join(", ", requirement.RelatedFunctionalRequirements))</p></article> } }</section>
    @{ var lists = new[] { ("6. External Interface Requirements", Model.ExternalInterfaceRequirements), ("7. Data Requirements", Model.DataRequirements), ("8. Constraints", Model.Constraints), ("9. Assumptions and Dependencies", Model.AssumptionsAndDependencies), ("10. Acceptance Criteria", Model.AcceptanceCriteria) }; }
    @foreach (var group in lists) { <section><h2>@group.Item1</h2>@if (group.Item2.Count == 0) { <p>Not specified.</p> } else { <ul>@foreach (string item in group.Item2) { <li>@item</li> }</ul> }</section> }
    <section><h2>11. AI Input Quality Summary</h2><p>@Model.AiQualitySummary</p></section>
</div>
