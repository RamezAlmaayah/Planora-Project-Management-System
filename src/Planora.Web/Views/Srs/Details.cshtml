@model Planora.Application.Common.Srs.SrsDocumentDetails
@{ ViewData["Title"] = Model.Title; Layout = "_AppLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/requirements.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/srs.css" asp-append-version="true" /> }
<div class="project-form-v3-page requirements-v3-page srs-v3-page">
    <div class="project-form-v3-back"><a asp-action="Index" asp-route-projectId="@Model.ProjectId">&larr; Back to SRS</a></div>
    <section class="project-form-v3-header"><span class="projects-v3-kicker">SAVED SRS &middot; SNAPSHOT</span><h1>@Model.Title</h1><p>@Model.ProjectName</p><div class="srs-v3-header-actions"><a asp-action="ExportTxt" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.Id" class="detail-v3-secondary">Download TXT</a><a asp-action="ExportPdf" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.Id" class="project-form-v3-submit">Download PDF</a></div></section>
    <section class="project-form-v3-panel srs-v3-metadata"><div><span>Saved</span><strong>@Model.SavedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Saved By</span><strong>@Model.SavedByName</strong></div><div><span>Generated By</span><strong>@Model.GeneratedByName</strong></div><div><span>Input Quality</span><strong>@Model.QualityScore/100 (@Model.QualityLevel)</strong></div></section>
    <partial name="_Content" model="Model.Content" />
</div>
