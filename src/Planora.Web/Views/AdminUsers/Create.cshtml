@model Planora.Web.ViewModels.AdminUsers.CreateAdminUserViewModel
@using Planora.Application.Common.Security
@{
    ViewData["Title"] = "Create User";
    Layout = "_AppLayout";
}
@section Styles { <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" /> }

<div class="project-form-v3-page admin-users-v3-page">
    <div class="project-form-v3-back"><a asp-action="Index">&larr; Back to users</a></div>
    <section class="project-form-v3-header"><div><span class="projects-v3-kicker">ADMINISTRATION</span><h1>Create user</h1><p>Create a confirmed Planora account using the existing password policy.</p></div></section>
    <form method="post" class="project-form-v3 admin-users-v3-form">
        <section class="project-form-v3-panel">
            <div asp-validation-summary="ModelOnly" class="v3-alert v3-alert-error"></div>
            <div class="project-form-v3-grid">
                <div class="project-form-v3-field project-form-v3-wide"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
                <div class="project-form-v3-field project-form-v3-wide"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
                <div class="project-form-v3-field"><label asp-for="GlobalRole"></label><select asp-for="GlobalRole"><option value="">Select role</option>@foreach (string role in SystemRoles.All) { <option value="@role">@role</option> }</select><span asp-validation-for="GlobalRole"></span></div>
                <div class="project-form-v3-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
                <div class="project-form-v3-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
            </div>
        </section>
        <div class="project-form-v3-actions"><a asp-action="Index" class="detail-v3-secondary">Cancel</a><button type="submit" class="project-form-v3-submit">Create user</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
